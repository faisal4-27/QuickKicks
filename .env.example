# Copy to .env at the repo root. Both the server and the migrate/seed scripts read it.

NODE_ENV=development
PORT=4000

# Ports match docker-compose.yml, which is offset from the defaults so it does not
# collide with a Postgres or Redis you may already have installed locally.
DATABASE_URL=postgres://quickkicks:quickkicks@localhost:5433/quickkicks
REDIS_URL=redis://localhost:6380

# Signs the nickname session cookie. Any long random string is fine locally.
SESSION_SECRET=change-me-to-something-long-and-random

# Origin allowed to talk to the API and the websocket.
# Locally: Vite (http://localhost:5173).
# Same-origin deploy: the public app URL.
# Vercel + Render: your Vercel URL (https://….vercel.app).
WEB_ORIGIN=http://localhost:5173

# Set true on Render when the frontend is on Vercel (cross-site cookies).
CROSS_ORIGIN=false

# How fast a simulated match runs: real milliseconds per match-minute.
# 2000 means a 90 minute match takes about 3 real minutes.
MATCH_MS_PER_MINUTE=2000

# --- Web (Vercel) only — set in the Vercel project env, not required locally ---
# VITE_API_URL=https://your-service.onrender.com
