# Copy to .env at the repo root. Both the server and the migrate/seed scripts read it.

NODE_ENV=development
PORT=4000

# Ports match docker-compose.yml, which is offset from the defaults so it does not
# collide with a Postgres or Redis you may already have installed locally.
DATABASE_URL=postgres://quickkicks:quickkicks@localhost:5433/quickkicks
REDIS_URL=redis://localhost:6380

# Signs the nickname session cookie. Any long random string is fine locally.
SESSION_SECRET=change-me-to-something-long-and-random

# Origin allowed to talk to the API and the websocket.
# Locally: Vite (http://localhost:5173).
# Same-origin deploy: the public app URL.
# Vercel + Render: your Vercel URL (https://….vercel.app).
WEB_ORIGIN=http://localhost:5173

# Set true on Render when the frontend is on Vercel (cross-site cookies).
CROSS_ORIGIN=false

# Where fixtures come from: api-football (real data) or mock (seeded catalogue, simulated matches).
MATCH_DATA=api-football

# --- API-Football (https://dashboard.api-football.com) ---
API_FOOTBALL_KEY=
# Leave empty to offer the competitions in apps/server/src/seed/competitions.json
# (top 5 leagues, UCL/UEL/UECL, Nations League, friendlies). Otherwise comma-separated league ids.
API_FOOTBALL_LEAGUES=
# Free plan budget is 100 requests/day. A live match polled every 90s costs ~75 requests
# (half time is polled less), so the free plan covers about one match a day. Drop to 15-30
# on a paid plan. Every room on the same match shares one poll.
API_FOOTBALL_LIVE_POLL_SECONDS=90
# Lineups are only checked for fixtures with a lobby waiting, from ~90 min before kickoff.
API_FOOTBALL_LINEUP_POLL_MINUTES=5
# Each fixture-list sync costs one request per day synced. The free plan only serves
# yesterday to tomorrow, so 2 (today + tomorrow) is its maximum; raise it on a paid plan.
API_FOOTBALL_FIXTURE_SYNC_HOURS=12
API_FOOTBALL_SYNC_DAYS=2

# How fast a simulated (MATCH_DATA=mock) match runs: real milliseconds per match-minute.
# 2000 means a 90 minute match takes about 3 real minutes.
MATCH_MS_PER_MINUTE=2000

# --- Web (Vercel) only — set in the Vercel project env, not required locally ---
# VITE_API_URL=https://your-service.onrender.com
